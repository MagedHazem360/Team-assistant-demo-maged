{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "description": "1–4000 characters after trimming; longer → 413.",
            "title": "Question",
            "type": "string"
          }
        },
        "required": ["question"],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "description": "The documents the answer drew on (ADR-0015).",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "message_id": {
            "description": "The stored assistant message.",
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          }
        },
        "required": ["message_id", "answer", "citations"],
        "title": "AskResponse",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["title", "path"],
        "title": "Citation",
        "type": "object"
      },
      "ConversationDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "description": "Oldest first.",
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at", "messages"],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationList": {
        "properties": {
          "count": {
            "description": "Number of items returned (not a total).",
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items", "count"],
        "title": "ConversationList",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at"],
        "title": "ConversationOut",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "updated_at"],
        "title": "ConversationSummary",
        "type": "object"
      },
      "CreateConversation": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional, at most 200 characters after trimming. Missing or blank → \"New conversation\"; the first question then replaces it (roadmap api 2.2).",
            "title": "Title"
          }
        },
        "title": "CreateConversation",
        "type": "object"
      },
      "ErrorBody": {
        "description": "The one error shape every api response uses.",
        "properties": {
          "error": {
            "description": "Stable snake_case code, e.g. not_found, validation_error.",
            "title": "Error",
            "type": "string"
          },
          "trace_id": {
            "description": "The request's trace id — the same value as the x-trace-id header.",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": ["error", "trace_id"],
        "title": "ErrorBody",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "citations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Citation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Assistant messages: the documents cited (ADR-0015).",
            "title": "Citations"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": ["user", "assistant"],
            "title": "Role",
            "type": "string"
          }
        },
        "required": ["id", "role", "content", "created_at"],
        "title": "MessageOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Team Assistant — api",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Health endpoint reporting observability state.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/info": {
      "get": {
        "description": "Consolidated status + version + runtime report for this service.\n\nExtends the /health shape with the build version and runtime/system\nmetadata. Reachable only via the BFF (web) on the internal network.",
        "operationId": "info_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Info Info Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info"
      }
    },
    "/ping": {
      "get": {
        "description": "Liveness greeting endpoint.",
        "operationId": "ping_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping"
      }
    },
    "/v1/conversations": {
      "get": {
        "operationId": "list_conversations_v1_conversations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "List conversations, newest first",
        "tags": ["conversations"]
      },
      "post": {
        "operationId": "create_conversation_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Start a conversation",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}": {
      "get": {
        "operationId": "get_conversation_v1_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown conversation (`not_found`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Read a conversation with its messages",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}/ask": {
      "post": {
        "operationId": "ask_in_conversation_v1_conversations__conversation_id__ask_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown conversation (`not_found`)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Question too long (`payload_too_large`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Model or search failed (`ai_unavailable`)"
          }
        },
        "summary": "Ask a question in a conversation",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}/ask/stream": {
      "post": {
        "operationId": "ask_in_conversation_stream_v1_conversations__conversation_id__ask_stream_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "SSE: `sources` → `token`* → `done`, or `error` after the first frame."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown conversation (`not_found`)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Question too long (`payload_too_large`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Failed before the first frame (`ai_unavailable`)"
          }
        },
        "summary": "Ask a question in a conversation, streamed",
        "tags": ["conversations"]
      }
    }
  }
}
